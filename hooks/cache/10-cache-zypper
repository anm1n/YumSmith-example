#!/usr/bin/bash
set -euo pipefail

zypper modifyrepo --keep-packages --all
zypper --non-interactive refresh

if [[ -f /etc/os-release ]]; then
    . /etc/os-release
fi

# see also: https://en.opensuse.org/SDB:DNF
echo ">>> Setup dnf for $PRETTY_NAME"
zypper --non-interactive install dnf dnf-plugins-core

if [[ "$ID" == "opensuse-tumbleweed" ]]; then
    zypper --non-interactive install rpm-repos-openSUSE-Tumbleweed
elif [[ "$ID" == "opensuse-leap" ]]; then
    zypper --non-interactive install rpm-repos-openSUSE-Leap
else
    echo ">>> warn: Failed to set up dnf repository for $ID"
fi

zypper --non-interactive install --download-only -t pattern \
    devel_basis \
    devel_C_C++ \
    devel_rpm_build

zypper --non-interactive install --download-only \
    rpmdevtools git \
    cargo rust go \
    dnf dnf-plugins-core
